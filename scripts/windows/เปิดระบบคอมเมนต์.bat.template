@echo off
chcp 65001 >nul
title ระบบคอมเมนต์เฟส PTP

set "HUB_URL=__HUB_URL__"
set "COMMENT_AGENT_TOKEN=__AGENT_TOKEN__"
set "COMMENT_AGENT_ID=__AGENT_ID__"
if "%COMMENT_AGENT_ID%"=="" set "COMMENT_AGENT_ID=owner"
if "%COMMENT_AGENT_ID%"=="__AGENT_ID__" set "COMMENT_AGENT_ID=owner"
set "BAKED_PROJECT_DIR=__PROJECT_DIR__"
set "PROJECT_ZIP_URL=__PROJECT_ZIP_URL__"
set "DEFAULT_PROJECT=%USERPROFILE%\Projects\pantip-property-automation"
set "PY_HOME=%LOCALAPPDATA%\Programs\Python\Python312"
set "PY_SETUP_URL=https://www.python.org/ftp/python/3.12.10/python-3.12.10-amd64.exe"

echo.
echo ========================================
echo   ระบบคอมเมนต์เฟสอัตโนมัติ (Windows)
echo ========================================
echo.
echo ใช้ได้กับคอมทั่วไป — ครั้งแรกจะเตรียมเอง
echo (โค้ด / Python / ไลบรารี / เบราว์เซอร์)
echo อาจใช้เวลาหลายนาที — อย่าปิดหน้าต่างนี้
echo.

set "PROJECT_DIR="
if not "%BAKED_PROJECT_DIR%"=="" if not "%BAKED_PROJECT_DIR%"=="/app" if exist "%BAKED_PROJECT_DIR%\scripts\comment_agent.py" set "PROJECT_DIR=%BAKED_PROJECT_DIR%"
if not defined PROJECT_DIR if exist "%~dp0..\..\scripts\comment_agent.py" (
  pushd "%~dp0..\.."
  set "PROJECT_DIR=%CD%"
  popd
)
if not defined PROJECT_DIR if exist "%DEFAULT_PROJECT%\scripts\comment_agent.py" set "PROJECT_DIR=%DEFAULT_PROJECT%"
if not defined PROJECT_DIR if exist "%USERPROFILE%\Projects\pantip-property-hub\scripts\comment_agent.py" set "PROJECT_DIR=%USERPROFILE%\Projects\pantip-property-hub"
if not defined PROJECT_DIR if exist "%USERPROFILE%\pantip-property-automation\scripts\comment_agent.py" set "PROJECT_DIR=%USERPROFILE%\pantip-property-automation"
if not defined PROJECT_DIR if exist "%USERPROFILE%\Desktop\pantip-property-automation\scripts\comment_agent.py" set "PROJECT_DIR=%USERPROFILE%\Desktop\pantip-property-automation"
if not defined PROJECT_DIR if exist "%USERPROFILE%\Documents\pantip-property-automation\scripts\comment_agent.py" set "PROJECT_DIR=%USERPROFILE%\Documents\pantip-property-automation"

if not defined PROJECT_DIR (
  echo ยังไม่มีโฟลเดอร์โปรเจกต์ — กำลังดาวน์โหลดจาก Hub...
  if not exist "%USERPROFILE%\Projects" mkdir "%USERPROFILE%\Projects"
  if exist "%DEFAULT_PROJECT%" rmdir /s /q "%DEFAULT_PROJECT%"
  mkdir "%DEFAULT_PROJECT%"
  set "TMPZIP=%TEMP%\ptp-hub-agent.zip"
  powershell -NoProfile -ExecutionPolicy Bypass -Command ^
    "try { Invoke-WebRequest -Uri $env:PROJECT_ZIP_URL -OutFile $env:TMPZIP -UseBasicParsing; Expand-Archive -Path $env:TMPZIP -DestinationPath $env:DEFAULT_PROJECT -Force; exit 0 } catch { Write-Host $_; exit 1 }"
  if exist "%DEFAULT_PROJECT%\scripts\comment_agent.py" set "PROJECT_DIR=%DEFAULT_PROJECT%"
)

if not defined PROJECT_DIR (
  echo [ผิดพลาด] ดาวน์โหลดโปรเจกต์ไม่สำเร็จ
  echo ลองดาวน์โหลดไฟล์ .bat ใหม่จาก Hub แล้วเปิดอีกครั้ง
  echo เช็คเน็ตแล้วดับเบิลคลิกไฟล์นี้อีกครั้ง
  echo.
  pause
  exit /b 1
)

echo โฟลเดอร์โปรเจกต์: %PROJECT_DIR%
echo กำลังเชื่อมต่อ Hub: %HUB_URL%
echo.
cd /d "%PROJECT_DIR%"

set "PY="
if exist "%PY_HOME%\python.exe" set "PY=%PY_HOME%\python.exe"
if not defined PY if exist "%LOCALAPPDATA%\Programs\Python\Python313\python.exe" set "PY=%LOCALAPPDATA%\Programs\Python\Python313\python.exe"
if not defined PY if exist "%LOCALAPPDATA%\Programs\Python\Python311\python.exe" set "PY=%LOCALAPPDATA%\Programs\Python\Python311\python.exe"
if not defined PY (
  where python >nul 2>&1
  if not errorlevel 1 for /f "delims=" %%i in ('where python') do (
    if not defined PY set "PY=%%i"
  )
)
if not defined PY (
  where py >nul 2>&1
  if not errorlevel 1 set "PY=py -3"
)

if not defined PY (
  echo ยังไม่มี Python — กำลังติดตั้งให้อัตโนมัติ (เงียบๆ)...
  where winget >nul 2>&1
  if not errorlevel 1 (
    winget install -e --id Python.Python.3.12 --accept-package-agreements --accept-source-agreements
  )
  if exist "%PY_HOME%\python.exe" set "PY=%PY_HOME%\python.exe"
  if not defined PY (
    where python >nul 2>&1
    if not errorlevel 1 set "PY=python"
  )
  if not defined PY (
    where py >nul 2>&1
    if not errorlevel 1 set "PY=py -3"
  )
)

if not defined PY (
  echo กำลังดาวน์โหลดตัวติดตั้ง Python...
  set "PYSETUP=%TEMP%\ptp-python-setup.exe"
  powershell -NoProfile -ExecutionPolicy Bypass -Command ^
    "try { Invoke-WebRequest -Uri $env:PY_SETUP_URL -OutFile $env:PYSETUP -UseBasicParsing; exit 0 } catch { Write-Host $_; exit 1 }"
  if exist "%PYSETUP%" (
    "%PYSETUP%" /quiet InstallAllUsers=0 PrependPath=1 Include_pip=1 Include_test=0 SimpleInstall=1
    if exist "%PY_HOME%\python.exe" set "PY=%PY_HOME%\python.exe"
  )
)

if not defined PY (
  echo [ผิดพลาด] ติดตั้ง Python ไม่สำเร็จ
  echo กำลังเปิดหน้าดาวน์โหลด — ติดตั้งแล้วติ๊ก "Add python.exe to PATH" แล้วเปิดไฟล์นี้อีกครั้ง
  start "" "https://www.python.org/downloads/windows/"
  echo.
  pause
  exit /b 1
)

echo ใช้ Python: %PY%

if exist ".git" (
  where git >nul 2>&1
  if not errorlevel 1 (
    echo กำลังอัปเดตระบบ (ถ้ามี)...
    git pull --ff-only 2>nul
  )
)

echo กำลังติดตั้งไลบรารีที่จำเป็น (ครั้งแรกอาจนานหน่อย)...
%PY% -m pip install -q -r requirements-agent.txt
if errorlevel 1 (
  echo [ผิดพลาด] ติดตั้งไลบรารีไม่สำเร็จ — ลองเปิดไฟล์นี้อีกครั้งเมื่อเน็ตพร้อม
  echo.
  pause
  exit /b 1
)

%PY% scripts\comment_agent.py --hub "%HUB_URL%" --token "%COMMENT_AGENT_TOKEN%" --agent "%COMMENT_AGENT_ID%"
echo.
echo ระบบหยุดแล้ว — ดับเบิลคลิกเปิดไฟล์นี้อีกครั้งเพื่อทำงานต่อ
pause
