#!/bin/bash
# ดาวน์โหลดจาก Hub — เปิดจาก Downloads ได้เลย
HUB_URL="__HUB_URL__"
COMMENT_AGENT_TOKEN="__AGENT_TOKEN__"
BAKED_PROJECT_DIR="__PROJECT_DIR__"

xattr -d com.apple.quarantine "$0" 2>/dev/null || true

clear
echo "========================================"
echo "  ระบบคอมเมนต์เฟสอัตโนมัติ (Mac)"
echo "========================================"
echo ""

# หาโฟลเดอร์โปรเจกต์บนเครื่องนี้ (ไม่ใช้ path ของเซิร์ฟเวอร์ถ้าไม่มีจริง)
PROJECT_DIR=""
if [ -d "$BAKED_PROJECT_DIR/scripts" ] && [ -f "$BAKED_PROJECT_DIR/scripts/comment_agent.py" ]; then
  PROJECT_DIR="$BAKED_PROJECT_DIR"
fi
if [ -z "$PROJECT_DIR" ]; then
  REL="$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd)"
  if [ -f "$REL/scripts/comment_agent.py" ]; then
    PROJECT_DIR="$REL"
  fi
fi
if [ -z "$PROJECT_DIR" ]; then
  for cand in \
    "$HOME/Projects/pantip-property-automation" \
    "$HOME/Projects/pantip-property-hub" \
    "$HOME/pantip-property-automation" \
    "$HOME/Desktop/pantip-property-automation" \
    "$HOME/Documents/pantip-property-automation"
  do
    if [ -f "$cand/scripts/comment_agent.py" ]; then
      PROJECT_DIR="$cand"
      break
    fi
  done
fi

if [ -z "$PROJECT_DIR" ]; then
  echo "[ผิดพลาด] หาโฟลเดอร์โปรเจกต์บน Mac เครื่องนี้ไม่เจอ"
  echo "ให้หัวหน้าทีม clone/คัดลอกโปรเจกต์ไว้ เช่น"
  echo "  ~/Projects/pantip-property-automation"
  echo "แล้วเปิดไฟล์นี้อีกครั้ง"
  echo ""
  read -r -p "กด Enter เพื่อปิดหน้าต่าง..."
  exit 1
fi

echo "โฟลเดอร์โปรเจกต์: $PROJECT_DIR"
echo "กำลังเชื่อมต่อ Hub: $HUB_URL"
echo "เปิดหน้าต่างนี้ทิ้งไว้ได้เลย — อย่าปิด"
echo ""

cd "$PROJECT_DIR" || exit 1

if ! command -v python3 >/dev/null 2>&1; then
  echo "[ผิดพลาด] เครื่องนี้ยังไม่มี Python3"
  echo "ให้หัวหน้าทีมติดตั้ง Python แล้วเปิดไฟล์นี้อีกครั้ง"
  echo ""
  read -r -p "กด Enter เพื่อปิดหน้าต่าง..."
  exit 1
fi

python3 scripts/comment_agent.py --hub "$HUB_URL" --token "$COMMENT_AGENT_TOKEN"
echo ""
echo "ระบบหยุดแล้ว — ดับเบิลคลิกไฟล์นี้อีกครั้งเพื่อเปิดใหม่"
read -r -p "กด Enter เพื่อปิดหน้าต่าง..."
