#!/bin/bash
# ดาวน์โหลดจาก Hub — ใช้ได้กับ Mac ทั่วไป (ระบบเตรียมเอง)
HUB_URL="__HUB_URL__"
COMMENT_AGENT_TOKEN="__AGENT_TOKEN__"
COMMENT_AGENT_ID="__AGENT_ID__"
export COMMENT_AGENT_ID
if [ -z "$COMMENT_AGENT_ID" ] || [ "$COMMENT_AGENT_ID" = "__AGENT_ID__" ]; then
  COMMENT_AGENT_ID="owner"
  export COMMENT_AGENT_ID
fi
BAKED_PROJECT_DIR="__PROJECT_DIR__"
PROJECT_ZIP_URL="__PROJECT_ZIP_URL__"
DEFAULT_PROJECT="$HOME/Projects/pantip-property-automation"

xattr -d com.apple.quarantine "$0" 2>/dev/null || true

clear
echo "========================================"
echo "  ระบบคอมเมนต์เฟสอัตโนมัติ (Mac)"
echo "========================================"
echo ""
echo "ใช้ได้กับ Mac ทั่วไป — ครั้งแรกจะเตรียมเอง"
echo "(โค้ด / ไลบรารี / เบราว์เซอร์)"
echo "อาจใช้เวลาหลายนาที — อย่าปิดหน้าต่างนี้"
echo ""

find_project() {
  PROJECT_DIR=""
  if [ -n "$BAKED_PROJECT_DIR" ] && [ "$BAKED_PROJECT_DIR" != "/app" ] && [ -f "$BAKED_PROJECT_DIR/scripts/comment_agent.py" ]; then
    PROJECT_DIR="$BAKED_PROJECT_DIR"
    return
  fi
  REL="$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd)"
  if [ -f "$REL/scripts/comment_agent.py" ]; then
    PROJECT_DIR="$REL"
    return
  fi
  for cand in \
    "$DEFAULT_PROJECT" \
    "$HOME/Projects/pantip-property-hub" \
    "$HOME/pantip-property-automation" \
    "$HOME/Desktop/pantip-property-automation" \
    "$HOME/Documents/pantip-property-automation" \
    "$HOME/Downloads/pantip-property-automation" \
    "$HOME/Downloads/pantip-property-hub"
  do
    if [ -f "$cand/scripts/comment_agent.py" ]; then
      PROJECT_DIR="$cand"
      return
    fi
  done
}

install_project() {
  echo "ยังไม่มีโฟลเดอร์โปรเจกต์ — กำลังดาวน์โหลดจาก Hub..."
  mkdir -p "$HOME/Projects"
  rm -rf "$DEFAULT_PROJECT"
  mkdir -p "$DEFAULT_PROJECT"
  TMPZIP="$(mktemp -t ptp-hub.XXXXXX.zip)"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$TMPZIP" "$PROJECT_ZIP_URL" || { rm -f "$TMPZIP"; return 1; }
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$TMPZIP" "$PROJECT_ZIP_URL" || { rm -f "$TMPZIP"; return 1; }
  else
    rm -f "$TMPZIP"
    return 1
  fi
  unzip -q "$TMPZIP" -d "$DEFAULT_PROJECT" || { rm -f "$TMPZIP"; return 1; }
  rm -f "$TMPZIP"
  if [ -f "$DEFAULT_PROJECT/scripts/comment_agent.py" ]; then
    PROJECT_DIR="$DEFAULT_PROJECT"
    return 0
  fi
  return 1
}

resolve_python() {
  PY=""
  for cand in python3 python3.12 python3.13 python3.11; do
    if command -v "$cand" >/dev/null 2>&1; then
      PY="$cand"
      return 0
    fi
  done
  for cand in \
    /opt/homebrew/bin/python3 \
    /usr/local/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/3.12/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/3.13/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/3.11/bin/python3
  do
    if [ -x "$cand" ]; then
      PY="$cand"
      return 0
    fi
  done
  return 1
}

ensure_python() {
  if resolve_python; then
    return 0
  fi
  echo "ยังไม่มี Python — กำลังลองติดตั้งให้อัตโนมัติ..."
  if command -v brew >/dev/null 2>&1; then
    brew install python@3.12 2>/dev/null || brew install python || true
    # refresh common brew paths
    export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
    if resolve_python; then
      return 0
    fi
  fi
  echo "[ผิดพลาด] เครื่องนี้ยังไม่มี Python3"
  echo "กำลังเปิดหน้าดาวน์โหลด Python ให้..."
  open "https://www.python.org/downloads/macos/" 2>/dev/null || open "https://www.python.org/downloads/" 2>/dev/null || true
  echo "ติดตั้งเสร็จแล้วค่อยเปิดไฟล์นี้อีกครั้ง"
  return 1
}

find_project
if [ -z "$PROJECT_DIR" ]; then
  if ! install_project; then
    echo "[ผิดพลาด] ดาวน์โหลดโปรเจกต์ไม่สำเร็จ"
    echo "เช็คเน็ตแล้วเปิดไฟล์นี้อีกครั้ง"
    echo ""
    read -r -p "กด Enter เพื่อปิดหน้าต่าง..."
    exit 1
  fi
fi

echo "โฟลเดอร์โปรเจกต์: $PROJECT_DIR"
echo "กำลังเชื่อมต่อ Hub: $HUB_URL"
echo ""

cd "$PROJECT_DIR" || exit 1

if ! ensure_python; then
  echo ""
  read -r -p "กด Enter เพื่อปิดหน้าต่าง..."
  exit 1
fi

echo "ใช้ Python: $PY"
export FB_BROWSER_MODE="${FB_BROWSER_MODE:-auto}"
export FB_CDP_URL="${FB_CDP_URL:-http://127.0.0.1:9222}"
echo "โหมดเบราว์เซอร์: $FB_BROWSER_MODE (แนะนำเปิด scripts/mac/เปิดChromeจริงสำหรับAgent.command ก่อน เพื่อใช้บัญชีที่เคยล็อกอิน)"
echo ""

# ดึงโค้ดล่าสุดถ้ามี git (เงียบๆ)
if command -v git >/dev/null 2>&1 && [ -d .git ]; then
  echo "กำลังอัปเดตระบบ (ถ้ามี)..."
  git pull --ff-only 2>/dev/null || true
fi

echo "กำลังติดตั้งไลบรารีที่จำเป็น (ครั้งแรกอาจนานหน่อย)..."
"$PY" -m pip install --user -q -r requirements-agent.txt 2>/dev/null \
  || "$PY" -m pip install -q -r requirements-agent.txt \
  || {
    echo "[ผิดพลาด] ติดตั้งไลบรารีไม่สำเร็จ"
    echo "ลองเปิดไฟล์นี้อีกครั้งเมื่อเน็ตพร้อม"
    echo ""
    read -r -p "กด Enter เพื่อปิดหน้าต่าง..."
    exit 1
  }

"$PY" scripts/comment_agent.py --hub "$HUB_URL" --token "$COMMENT_AGENT_TOKEN" --agent "$COMMENT_AGENT_ID"
echo ""
echo "ระบบหยุดแล้ว — เปิดไฟล์นี้อีกครั้งเพื่อทำงานต่อ"
read -r -p "กด Enter เพื่อปิดหน้าต่าง..."
